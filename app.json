{
  "expo": {
    "name": "BetterPlayer",
    "slug": "betterplayer",
    "owner": "betterplayer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "betterplayer",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070B16",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.betterplayer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070B16",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#070B16"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Betterplayer uses your photos so you can add a screenshot of your match result.",
          "cameraPermission": "Betterplayer uses your camera so you can photograph your match result."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/betterplayer-app"
    },
    "extra": {
      "eas": {
        "projectId": "b2481696-ad1d-46ee-b764-706a243d38cd"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b2481696-ad1d-46ee-b764-706a243d38cd"
    }
  }
}
