{
  "expo": {
    "name": "BetterPlayer",
    "slug": "betterplayer",
    "owner": "betterplayer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "betterplayer",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A3527",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.betterplayer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F4D3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A3527"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/betterplayer-app"
    },
    "extra": {
      "eas": {
        "projectId": "b2481696-ad1d-46ee-b764-706a243d38cd"
      }
    }
  }
}
