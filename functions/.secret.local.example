# Values for the Firebase emulator only. Copy to functions/.secret.local
# (git-ignored). Real secrets live in Secret Manager, never here or in code.
# Any value at least 8 characters long makes the emulator tests run: mail is
# only built, never sent, and the vision API is never called.
GMAIL_APP_PASSWORD=emulator-only-dummy-value
ANTHROPIC_API_KEY=emulator-only-dummy-value
