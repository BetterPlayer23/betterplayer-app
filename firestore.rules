rules_version = '2';

// Betterplayer Firestore security rules. Deployed by the "Firebase deploy"
// workflow (and ./deploy.sh).
//
// Money rule: the app never writes credits, matches or disputes. Only Cloud
// Functions do, and they bypass these rules. Anything not listed here is
// closed by the catch-all at the bottom.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Admins have a document at admins/{uid}, created by hand in the console.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isMatchPlayer(matchId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.playerUids;
    }

    // The platforms a player plays on: 1 to 5 of these, no repeats.
    function validPlatforms(p) {
      return p is list
        && p.size() >= 1 && p.size() <= 5
        && p.hasOnly(['pc', 'playstation', 'xbox', 'switch', 'mobile'])
        && p.toSet().size() == p.size();
    }

    function validGamerTag(tag) {
      return tag is string && tag.matches('^[A-Za-z0-9_]{3,20}$');
    }

    function validGameId(ids, key) {
      return !(key in ids) || (ids[key] is string && ids[key].size() > 0 && ids[key].size() <= 40);
    }

    function validGameIds(ids) {
      return ids is map
        && ids.keys().hasOnly(['eaId', 'activisionId', 'epicName', 'clashRoyaleTag'])
        && validGameId(ids, 'eaId')
        && validGameId(ids, 'activisionId')
        && validGameId(ids, 'epicName')
        && validGameId(ids, 'clashRoyaleTag')
        && (!('clashRoyaleTag' in ids) || ids.clashRoyaleTag.matches('^#[0289PYLQGRJCUV]{3,14}$'));
    }

    // users/{uid}: a player's own profile. No credits or reputation here:
    // those are server-only.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'gamerTag', 'platforms', 'ageConfirmed', 'ageConfirmedAt',
             'country', 'gameIds', 'createdAt'])
        && request.resource.data.keys().hasAll([
             'gamerTag', 'platforms', 'ageConfirmed', 'ageConfirmedAt',
             'country', 'gameIds', 'createdAt'])
        && validGamerTag(request.resource.data.gamerTag)
        && validPlatforms(request.resource.data.platforms)
        && request.resource.data.ageConfirmed == true
        && request.resource.data.ageConfirmedAt == request.time
        && request.resource.data.country == 'ES'
        && validGameIds(request.resource.data.gameIds)
        && request.resource.data.createdAt == request.time;

      // Players may only change their gamer tag, game IDs and platforms (and
      // remove the old single "platform" field when they save platforms).
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['gamerTag', 'gameIds', 'platforms', 'platform'])
        && !('platform' in request.resource.data
             && request.resource.data.diff(resource.data).affectedKeys().hasAny(['platform']))
        && validGamerTag(request.resource.data.gamerTag)
        && validGameIds(request.resource.data.gameIds)
        && (!('platforms' in request.resource.data)
            || validPlatforms(request.resource.data.platforms));

      allow delete: if false;
    }

    // wallets/{uid}: a player's credit summary (available, locked).
    // Written only by Cloud Functions, in the same transaction as the ledger.
    match /wallets/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ledger/{entryId}: append-only credit history. Players can read only
    // their own entries. Written only by Cloud Functions.
    match /ledger/{entryId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // matches/{matchId}: any signed-in player can see matches (lobby, rooms).
    // Only Cloud Functions create or change them.
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Result reports and disputes: players of this match and admins can read.
      // Only Cloud Functions write them.
      match /reports/{uid} {
        allow read: if isMatchPlayer(matchId) || isAdmin();
        allow write: if false;
      }
      match /disputes/{uid} {
        allow read: if isMatchPlayer(matchId) || isAdmin();
        allow write: if false;
      }
      // Lobby code and the players' game IDs: only the match's players and
      // admins. Written only by Cloud Functions.
      match /private/{doc} {
        allow read: if isMatchPlayer(matchId) || isAdmin();
        allow write: if false;
      }
    }

    // admin_reviews/{matchId}: admin decisions. Admins read; functions write.
    match /admin_reviews/{reviewId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // admins/{uid}: a player can check whether they are an admin (to show the
    // Admin tab). Created by hand in the console, never from the app.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // playerStats/{uid}: stats per game from settled matches (server-only).
    // Any signed-in player can read them, e.g. to check an opponent.
    match /playerStats/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // config/fees: the current fee rate, shown in the app. Changed by hand in
    // the console. (Other config documents stay closed.)
    match /config/fees {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Leaderboards, season totals, badges and crowns: any signed-in player can
    // read them (they're public in the app). Only Cloud Functions write them.
    match /leaderboards/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /seasonStats/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /badges/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /records/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // notifications/{uid}/items/{id}: a player's own messages (tier lost, crown
    // lost, trophy, founder). The owner may only mark them as read.
    match /notifications/{uid}/items/{id} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }

    // rankingExclusions/{uid}: admin / test accounts left out of rankings
    // (users/{uid}.excludeFromRankings, set only by Cloud Functions). Admins only.
    match /rankingExclusions/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // flags/{matchId}: suspicious patterns (anti-farming), admins only.
    match /flags/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // reputation/{uid}: server-only, readable by its owner.
    match /reputation/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // waitlist/{docId}: sign-ups from the landing page. Anyone may add an
    // entry; nobody can read, change or delete entries from an app or browser.
    match /waitlist/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'eaId', 'platform', 'consent', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'eaId', 'platform', 'consent', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.eaId is string
        && request.resource.data.eaId.size() <= 40
        && request.resource.data.platform in ['PlayStation', 'Xbox', 'PC']
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Catch-all: every other collection (credits, ledger, matches, disputes...)
    // is closed to the app and the website. Cloud Functions bypass these rules.
    // ---- Fair play (anti-cheat). The rules for checking results are secret:
    // serverConfig/antiCheat (thresholds), boardsPrivate, seasonPrivate,
    // playerChecks, photoReads, pendingPromotions, disqualified and
    // reportCounts are closed to every app user, admins included (the Admin
    // tab reads the settings through the getAntiCheatSettings function).
    match /serverConfig/{id} {
      allow read, write: if false;
    }

    // What the photo check read, the verdict and why a match went to review.
    match /matchReview/{matchId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin lists: spot checks, held results, player reports, audit log.
    match /spotChecks/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /heldResults/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /playerReports/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // This season's totals of rejected results and deactivated accounts
    // (leaderboard footer).
    match /publicStats/{season} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
